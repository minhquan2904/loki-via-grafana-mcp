# Copy to .env and fill in. Every optional variable below is commented out; the
# defaults documented in README.md apply when it is absent.

# Grafana base URL of the stack that holds the Loki datasource. No trailing slash.
GRAFANA_URL=https://your-stack.grafana.net

# Either this file or GRAFANA_SERVICE_ACCOUNT_TOKEN must be set. The file form
# wins. The token is never printed: not in logs, not in errors.
#GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE=./.secrets/grafana_sa_token
#GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Transport: stdio (default) or http.
#MCP_TRANSPORT=http

# Listen address for the http transport.
#MCP_LISTEN=127.0.0.1:8000

# Bearer token for /mcp, required when MCP_TRANSPORT=http. At least 16 characters.
#MCP_TOKEN_FILE=./.secrets/mcp_token
#MCP_TOKEN=

# Host header patterns accepted by /mcp; "*" as the port means any port.
#MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# Header carrying the caller identity for the access log.
#MCP_USER_HEADER=X-MCP-Gateway-User

# debug, info, warn or error.
#LOG_LEVEL=info

# Timeout for every Grafana call, between 1ms and 5m.
#GRAFANA_TIMEOUT=60s

# Required to talk to a plain http Grafana that is not on loopback: without it
# the service account token would travel unencrypted.
#GRAFANA_ALLOW_INSECURE=false

# Concurrent /mcp requests; a request that waits longer than 30s gets 503.
#MCP_MAX_CONCURRENT=16
